{% extends "layout.njk" %}
{% block content %}
<div class="stats">
  <a class="stat" href="/jobs?status=new"><div class="n"><span id="s-unranked">{{ stats.unranked }}</span></div><div class="k">📥 unranked</div></a>
  <a class="stat" href="/jobs?favorite=1"><div class="n"><span id="s-fav">{{ stats.favorites }}</span></div><div class="k">★ favorites</div></a>
  <a class="stat" href="/jobs?status=shortlist"><div class="n"><span id="s-shortlist">{{ stats.counts.shortlist or 0 }}</span></div><div class="k">shortlist</div></a>
  <a class="stat" href="/jobs?status=applied"><div class="n"><span id="s-applied">{{ stats.counts.applied or 0 }}</span></div><div class="k">applied</div></a>
  <a class="stat" href="/jobs?status=interview"><div class="n"><span id="s-interview">{{ stats.counts.interview or 0 }}</span></div><div class="k">interview</div></a>
  <a class="stat" href="/jobs?status=offer"><div class="n"><span id="s-offer">{{ stats.counts.offer or 0 }}</span></div><div class="k">offer</div></a>
</div>

<h2 class="section">📥 Inbox — new &amp; unranked ({{ inbox | length }})</h2>
<div class="rows">
  {% for row in inbox %}{% include "_row.njk" %}{% else %}<div class="empty">Der Stapel ist abgearbeitet — nothing new to triage.</div>{% endfor %}
</div>

<h2 class="section">Shortlist ({{ shortlist | length }})</h2>
<div class="rows">
  {% for row in shortlist %}{% include "_row.njk" %}{% else %}<div class="empty">Nothing shortlisted yet.</div>{% endfor %}
</div>
{% endblock %}
